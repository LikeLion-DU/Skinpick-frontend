<?xml version="1.0" encoding="utf-8"?>
<!--
  디버그 빌드 전용. 같은 이름의 main 리소스를 덮어쓴다(빌드 타입 리소스 우선).

  실기기로 개발할 때는 앱이 개발 PC 의 LAN IP(예: 172.30.1.67)로 붙는데, 그 값은
  네트워크가 바뀔 때마다 달라진다. main 설정처럼 호스트를 하나씩 적어 두면 카페나
  발표장에서 IP 가 바뀌는 순간 "왜 안 붙지" 로 30분이 나간다.

  **릴리즈 빌드에는 적용되지 않는다.** main 의 설정(10.0.2.2 · localhost 만 허용)이
  그대로 남아 있어서, 배포본은 여전히 HTTPS 만 쓴다.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
